{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wohnquartier-geseke-west",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "wohnquartier-geseke-leads",
      "database_id": "f793ab88-16fe-49bc-b202-898a7cd4e7a7",
      "migrations_dir": "migrations"
    }
  ]
}
